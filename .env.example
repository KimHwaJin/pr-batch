# Use a dedicated schema and a role authorized for that schema.
BATCH_DATABASE_URL=postgresql+psycopg://batch:CHANGE_ME@localhost:5432/batch
# Absolute path. Must already be mounted before starting the service.
BATCH_STORAGE_ROOT=/absolute/path/to/shared-pv
# RSA public key that verifies caller tokens (relative to the project root).
# `make auth-keys` writes a local pair to .local-keys/.
BATCH_AUTH_PUBLIC_KEY_FILE=.local-keys/auth_public.pem
BATCH_AUTH_ISSUER=batch-client
BATCH_AUTH_AUDIENCE=pr-batch
# Runtimes (kernel profiles) are read from the Executor BATCH pool;
# there is no local allowlist. Cache TTL in seconds:
# BATCH_RUNTIME_CATALOG_TTL_SECONDS=30
BATCH_UPLOAD_MAX_BYTES=10485760
# Local port for `make serve` / `uv run pr-batch`; 8100 keeps clear of a
# local Executor on 8000. Images default to 8000 (PORT in config.yml).
BATCH_PORT=8100
BATCH_MAX_CODE_CELLS=100
BATCH_CELL_MAX_BYTES=1048576

# Internal Executor service origin; omit to keep runs unavailable.
# Do not append /api/v1. The API process also runs the scheduler and task
# dispatcher (src/app/runtime); there are no separate worker processes.
# BATCH_EXECUTOR_BASE_URL=http://executor-service:8000

# Runtime tuning (defaults shown).
# BATCH_DB_AUTO_MIGRATE=true
# BATCH_DB_POOL_SIZE=3
# BATCH_DB_MAX_OVERFLOW=3
# BATCH_TASK_CONCURRENCY=4
# BATCH_SYNC_INITIAL_SECONDS=5
# BATCH_SYNC_MAX_SECONDS=60
