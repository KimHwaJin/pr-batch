# Use a dedicated schema and a role authorized for that schema.
DATABASE_URL=postgresql+psycopg://batch:CHANGE_ME@localhost:5432/batch
# Absolute path. Must already be mounted before starting the service.
STORAGE_ROOT=/absolute/path/to/shared-pv
# Calling services: SHA-256 of each key, never the key (docs/client-auth.md).
# Local-only entry, the same as compose.yaml; call with
#   X-Api-Key: bat_local_agent_0123456789abcdef0123456789ab
AUTH_CLIENTS='[{"name": "pr-agentic-service", "key_sha256": ["3c6daf387c58d74d1ce645976dc47d5beaaa17c04cb875c663ef13c73e919321"], "tenant": "dtest-agent-service", "relay": true, "allowed_tenants": ["*"], "admin": true}]'
# Runtimes offered for batches come from BATCH_RUNTIMES (config.yml).
UPLOAD_MAX_BYTES=10485760
# Local port for `make serve` / `uv run pr-batch`; 8100 keeps clear of a
# local Executor on 8000. Images default to 8000 (PORT in config.yml).
PORT=8100
MAX_CODE_CELLS=100
MAX_NOTEBOOK_CELLS=1000
# Swagger at /docs locally; keep off in shared environments.
DOCS_ENABLED=true
CELL_MAX_BYTES=1048576

# Internal Executor service origin; omit to keep runs unavailable.
# Do not append /api/v1. The API process also runs the scheduler and task
# dispatcher (src/app/runtime); there are no separate worker processes.
# EXECUTOR_BASE_URL=http://executor-service:8000
# Key this service sends to the Executor as X-Api-Key.
# EXECUTOR_API_KEY=exe_...

# Runtime tuning (defaults shown).
# DB_AUTO_MIGRATE=true
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=4
# TASK_CONCURRENCY=2
# IDLE_MAX_SECONDS=1
# SYNC_INITIAL_SECONDS=5
# SYNC_MAX_SECONDS=60
# TASK_GIVE_UP_SECONDS=86400        # fail a run after a day of failed calls
# SCHEDULE_RETRY_SECONDS=300        # retry a batch whose admission failed
# SCHEDULE_RETRY_LIMIT=3            # then skip its due occurrences
# IDEMPOTENCY_RETENTION_DAYS=7
# TASK_RETENTION_DAYS=30
