edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="370" as="sourcePoint"/><mxPoint x="400" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="Run + SUBMIT Task 생성 (Executor 호출 없음)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="405" as="sourcePoint"/><mxPoint x="680" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="③ 실행 진행 (Task dispatcher가 Executor 호출)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=10;arcSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="435" width="1300" height="26" as="geometry"/></mxCell><mxCell id="e22" value="SUBMIT: POST /api/v1/executions" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="490" as="sourcePoint"/><mxPoint x="1240" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e23" value="SYNC: GET /api/v1/executions/{id} (5→60초 간격 반복)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="525" as="sourcePoint"/><mxPoint x="1240" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="COLLECT: GET /api/v1/executions/{id}/result" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="560" as="sourcePoint"/><mxPoint x="1240" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="호출 결과마다 Run 상태 갱신 (QUEUED → RUNNING → COLLECTING → 종료)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="595" as="sourcePoint"/><mxPoint x="680" y="595" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="셀 파일 읽기 (공유 스토리지 같은 경로)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="630" as="sourcePoint"/><mxPoint x="680" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="④ 조회·취소 (호출 서비스가 요청)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=10;arcSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="1300" height="26" as="geometry"/></mxCell><mxCell id="e28" value="GET /api/v1/batches/{id}/runs/{run_id}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="715" as="sourcePoint"/><mxPoint x="400" y="715" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e29" value="POST …/runs/{run_id}/cancel → 202" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="750" as="sourcePoint"/><mxPoint x="400" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value="CANCEL: POST /api/v1/executions/{id}/cancel" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="785" as="sourcePoint"/><mxPoint x="1240" y="785" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n31" value="인증: 호출 서비스 → pr-batch는 X-Api-Key + X-User-Id (+ X-Tenant-Id, X-Project-Id). pr-batch → Executor는 EXECUTOR_API_KEY + Run 접수 때 고정된 신원 헤더. 실행 결과 리포트는 pr-agentic-service가 Executor 이벤트로 작성한다(pr-batch 범위 밖)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=none;strokeColor=none;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
