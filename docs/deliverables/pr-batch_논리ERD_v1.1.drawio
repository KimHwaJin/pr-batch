의 대응은 Table 정의서 참조&lt;br&gt;멱등성 기록은 다른 엔터티와 관계가 없는 독립 엔터티" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1200" y="748" width="260" height="210" as="geometry"></mxGeometry></mxCell><mxCell id="c305" value="스크립트" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200.0" y="978" width="59.0" height="26" as="geometry"></mxGeometry></mxCell><mxCell id="c306" value="배치" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1265.0" y="978" width="59.0" height="26" as="geometry"></mxGeometry></mxCell><mxCell id="c307" value="실행" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1330.0" y="978" width="59.0" height="26" as="geometry"></mxGeometry></mxCell><mxCell id="c308" value="내부 처리" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1395.0" y="978" width="59.0" height="26" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
